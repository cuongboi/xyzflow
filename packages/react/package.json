{
  "name": "xyzflow",
  "version": "0.1.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "devDependencies": {
    "@react-three/fiber": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/three": "catalog:",
    "@xyzflow/tsconfig": "workspace:*",
    "bump": "^0.2.5",
    "react": "catalog:",
    "three": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9.0.0",
    "react": ">=19.0.0",
    "three": ">=0.170.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuongboi/xyzflow.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/cuongboi/xyzflow#readme",
  "bugs": {
    "url": "https://github.com/cuongboi/xyzflow/issues"
  },
  "description": "High-performance 3D node editor for React Three Fiber. React Flow ergonomics, typed-array core, instanced rendering.",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "three",
    "react-three-fiber",
    "node-editor",
    "flow",
    "3d",
    "graph"
  ],
  "license": "MIT",
  "author": "Cuong Cam <cuongnt2612@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "bench": "bun ./bench/core.ts",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "bun run build && bun test ./test"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}